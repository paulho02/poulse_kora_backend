POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=app
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres/app
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres/apptest
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
TEST_REDIS_URL=redis://:CHANGE_ME@redis:6379/1
# Refused at startup as-is: must be at least 32 characters and not a placeholder.
SECRET_KEY=CHANGE_ME
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# --- logging ---
# Defaults are the intended settings for local dev; app/core/logger.py documents
# the whole strategy and RAILWAY.md the deployed side. LOG_FORMAT=auto means
# console here and JSON on Railway (where JSON keys become filterable
# attributes), so neither needs to be set. Two worth knowing about while
# developing:
#   LOG_LEVEL=DEBUG                    everything, including per-op fan-out
#   LOG_LEVEL_OVERRIDES={"app.feed":"DEBUG"}   just the feed, at INFO elsewhere
# LOG_SQL=true prints every statement SQLAlchemy runs - useful for a few minutes
# when chasing a query, unusable as a standing setting.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- reviewing the price range locally ---
# The client shows what a post costs as a range, because every (channel,
# language) route is priced separately. On a quiet dev deployment there is no
# congestion, so the base price sits at FEED_PRICE_MIN and +-50% of 1 rounds
# back to 1 - every route prices the same and the range correctly collapses to a
# single number. That is the formula working, not a bug, but it does mean the
# range is invisible until there is traffic. To see it locally, raise the floor
# for a session:
#   FEED_PRICE_MIN=8
# and reload the channel list once (that is what prices every route and so what
# the deployment-wide range is observed from). Revert when you are done - this
# is an economy setting, not a display one.

# --- content languages ---
# The languages a *post* can be written in, and so the language half of the feed's
# routing key: a post declares one, a reader accepts a set (User.content_languages),
# and fan-out only delivers where the two meet. Defaults to ["en","de"], which is why
# it is commented out here - set it only to change the list.
#
# Deliberately separate from SUPPORTED_LOCALES (the language the API *answers* in):
# a language people post in needs no translated error catalogue, and a locale we
# translate into need not become a content bucket the day its .arb file lands.
#
# Adding one is additive and safe: no existing post or reader changes meaning, the
# new language's audience sets simply start empty. Run
# `python -m scripts.dangerous.rebuild_redis` afterwards so readers who had already
# subscribed get memberships in it. Removing one is NOT the inverse - posts and
# readers keep the value in Postgres, and it degrades to "routes to nobody" rather
# than to an error.
#
# "und" is reserved (it means "no language at all", which routes through the whole
# channel) and is rejected here at startup.
# CONTENT_LANGUAGES='["en","de"]'

# --- object storage (media bucket) ---
# Local dev/CI use the MinIO container in docker-compose.yml; production uses a
# Railway Bucket. The backend speaks the same S3+SigV4 protocol to both, so only
# these variables change - see RAILWAY.md for the production values.
#
# AWS_ENDPOINT_URL is how the *backend* reaches the bucket (compose network).
# S3_PUBLIC_ENDPOINT_URL is how the *client* reaches it, and it is what
# presigned URLs are signed for - the host is part of the signature, so these must
# each name the host that will actually be dialled. Change the public one to match
# how you run the client:
#   Flutter web / iOS simulator ....... http://localhost:9000
#   Android emulator .................. http://10.0.2.2:9000
#   physical device on your LAN ....... http://<your-machine-ip>:9000
# Your machine's LAN IP is the one value that satisfies all three at once, so it
# is usually the least annoying setting while developing against a real phone.
# On Windows it also needs an inbound firewall rule for port 9000 — publishing
# the port in docker-compose is not enough, and the symptom is specific and
# misleading: the app works, the feed loads, images quietly fall back to their
# placeholder (by design) and only video visibly fails, because only video
# reports an error. The rule mirrors whatever you already added for the backend
# on 8000, e.g. in an elevated PowerShell:
#   New-NetFirewallRule -DisplayName localMinioDev -Direction Inbound \
#     -Action Allow -Protocol TCP -LocalPort 9000 -Profile Private
AWS_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# pytest runs inside the backend container, so "the client" there reaches MinIO
# on the compose network rather than on the host.
TEST_S3_PUBLIC_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=peerkola-media
# Separate bucket for pytest, mirroring TEST_DATABASE_URL/TEST_REDIS_URL - a test
# run must never write into (or delete out of) the bucket the dev app is using.
TEST_S3_BUCKET_NAME=peerkola-media-test
AWS_DEFAULT_REGION=us-east-1
# MinIO root credentials; also consumed by the minio service in docker-compose.yml.
# Password must be at least 8 characters. Local-only values - Railway injects real
# scoped credentials.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=CHANGE_ME_minio
# path-style, because <bucket>.localhost does not resolve. Railway needs "virtual".
S3_ADDRESSING_STYLE=path
# Create the bucket on boot if missing. Local/CI only; on Railway the platform
# provisions it and the credentials are not allowed to create buckets.
S3_AUTO_CREATE_BUCKET=true

# --- supporter subscription (Mollie) ---
# SUBSCRIPTIONS_ENABLED defaults to false — leave unset until Mollie is actually
# configured. MOLLIE_API_KEY: get a test-mode key (`test_...`) from
# https://my.mollie.com to develop against without moving real money.
SUBSCRIPTIONS_ENABLED=false
MOLLIE_API_KEY=
# Must be a publicly reachable HTTPS URL for Mollie's webhook to ever reach this
# backend — a local dev server needs a tunnel (e.g. ngrok) with that URL set here.
PUBLIC_BASE_URL=http://localhost:8000

# --- outbound email ---
# Which connector send_email uses (app/core/email.py). Both ship in the image;
# this picks one.
#   smtp        any relay, via SMTP_* below. The default.
#   lettermint  https://lettermint.co, the EU transactional provider, via its
#               official SDK and LETTERMINT_* below.
EMAIL_PROVIDER=smtp
#
# SMTP connector. Leaving SMTP_HOST unset (the local-dev default) is what makes
# verification codes appear in `docker compose logs backend` instead of in an
# inbox, so registration works end-to-end here with no relay at all.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_FROM_EMAIL=no-reply@poulse.com
# SMTP_FROM_NAME=Peerkola
#
# Lettermint connector. LETTERMINT_API_TOKEN is a *sending* token from the
# Lettermint dashboard, not a team API token, and it is required the moment
# EMAIL_PROVIDER=lettermint - the app refuses to start without it rather than
# quietly logging codes the way the unconfigured SMTP path does. There is no
# local sandbox: pointing this at Lettermint sends real mail, so leave the
# provider on smtp for day-to-day dev.
# LETTERMINT_API_TOKEN=
# The from-address domain must be verified in the Lettermint account, or every
# send comes back 422 "The domain '...' is not verified or does not belong to
# your account" - which is what the email.lettermint_rejected log line reports.
# Optional. Unset uses the account's default sending route.
# LETTERMINT_ROUTE=
# Optional, both fall back to SMTP_FROM_EMAIL / SMTP_FROM_NAME. Only needed if
# the domain verified in Lettermint differs from the one the SMTP relay sends as.
# LETTERMINT_FROM_EMAIL=
# LETTERMINT_FROM_NAME=
# Optional. Unset uses the SDK default (https://api.lettermint.co/v1).
# LETTERMINT_API_BASE_URL=
# LETTERMINT_TIMEOUT_SECONDS=30

# --- data-subject requests (GDPR Art. 15 / Art. 20) ---
# The address printed in the export's README, and the one the privacy policy
# should name: where a request goes that the automated download cannot answer.
# Defaults to support@poulse.com, so this only needs setting if that changes.
# SUPPORT_EMAIL=support@poulse.com
#
# `GET /users/me/export` streams every object the account uploaded back out of
# the bucket, so it has its own rate-limit budget rather than sharing the
# interaction one. Three a day is well clear of "manifestly excessive"; set the
# limit to 0 to disable the budget entirely.
# ACCOUNT_EXPORT_RATE_LIMIT=3
# ACCOUNT_EXPORT_RATE_WINDOW_SECONDS=86400

# --- Google sign-in ---
# Defaults to false; leave unset until the Google Cloud OAuth clients exist.
# GOOGLE_CLIENT_IDS lists the `aud` values accepted on incoming ID tokens. The
# mobile app passes the *web* client ID as google_sign_in's `serverClientId` on
# Android and as `clientId` on web, so one entry usually covers both platforms.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_IDS='["CHANGE_ME.apps.googleusercontent.com"]'

# --- Railway / deployed environments ---
# This file is the local-dev/CI template only; it is never used as-is on Railway.
# See RAILWAY.md for the full deploy guide. Quick reference for what changes there:
#
# DATABASE_URL / REDIS_URL: don't set literal values in Railway. Instead reference
#   the Postgres/Redis service variables, e.g. ${{Postgres.DATABASE_URL}} and
#   ${{Redis.REDIS_URL}} (exact names depend on what you called those services).
#   TEST_DATABASE_URL / TEST_REDIS_URL are dev/CI-only (pytest) and don't need to be
#   set on Railway at all.
# SECRET_KEY: generate a real one per environment, e.g. `openssl rand -hex 32`.
#   Never reuse a CHANGE_ME/dev value anywhere reachable from the internet.
# BACKEND_CORS_ORIGINS: must list the exact https:// origin(s) the deployed Flutter
#   web app is served from (its Railway domain, and any custom domain), e.g.
#   '["https://app.peerkola.com"]'. No wildcards.
# REQUIRE_STRONG_PASSWORD: defaults to false (fine for pure local dev). Set to true
#   for any environment reachable over the internet, including "int".
# EMAIL_PROVIDER and its connector's settings: one of the two must be configured
#   for real once real users need to receive the email-verification code
#   (REQUIRE_EMAIL_VERIFICATION defaults to true). Either EMAIL_PROVIDER=smtp with
#   SMTP_HOST / SMTP_PORT / SMTP_USERNAME / SMTP_PASSWORD / SMTP_FROM_EMAIL, or
#   EMAIL_PROVIDER=lettermint with LETTERMINT_API_TOKEN. Left on smtp with no
#   SMTP_HOST, verification codes are only logged server-side and no one can
#   complete verification; the `app.started` log line reports which connector is
#   live and whether it is configured.
# AWS_* / S3_*: point at the Railway Bucket instead of the local MinIO container.
#   AWS_ENDPOINT_URL, S3_BUCKET_NAME, AWS_DEFAULT_REGION, AWS_ACCESS_KEY_ID and
#   AWS_SECRET_ACCESS_KEY are set for you by the bucket's Connect action - those
#   names are the whole reason they are not called STORAGE_*. What Connect cannot
#   know, and you must still set by hand:
#     S3_ADDRESSING_STYLE=virtual  (required - Railway serves <bucket>.storage.railway.app)
#     S3_AUTO_CREATE_BUCKET        unset (false) - the platform provisions the bucket
#     S3_PUBLIC_ENDPOINT_URL       unset - the endpoint is already the public one there
#   TEST_S3_BUCKET_NAME is dev/CI-only, like the other TEST_ variables.
# GOOGLE_OAUTH_ENABLED / GOOGLE_CLIENT_IDS: set both once the Google Cloud OAuth
#   clients exist. The web client's "Authorized JavaScript origins" must list every
#   origin the Flutter web app is served from (http://localhost:3000 for dev, plus
#   the deployed domains); the Android client needs the signing SHA-1 of whichever
#   keystore the APK is built with.
# SENTRY_DSN: declared in config.py but not wired to anything yet - see the
#   "Logs and monitoring" section of RAILWAY.md for what it would buy over
#   Railway's own log explorer.
# ENVIRONMENT: set per Railway environment ("production", "int"). It is stamped on
#   every log line, which is what lets one query tell two environments apart.
# Nothing to set for logging on Railway beyond ENVIRONMENT: the JSON format and
#   reading the caller's IP from X-Forwarded-For are both derived from Railway's
#   own environment variables. See RAILWAY.md.
